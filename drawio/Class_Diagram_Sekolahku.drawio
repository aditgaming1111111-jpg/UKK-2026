<mxfile host="app.diagrams.net">
  <diagram name="Halaman-1" id="kJlnEVuqnQFgqKv2TzWR">
    <mxGraphModel dx="5050" dy="2804" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\ndirection LR\n\nclass User {\n    +bigint id\n    +string name\n    +string email\n    +string password\n    +enum role\n    +boolean is_active\n    +timestamp created_at\n    +timestamp updated_at\n    +login()\n    +logout()\n    +hasRole()\n    +updateProfile()\n}\n\nclass Guru {\n    +bigint id\n    +string nip\n    +enum jenis_kelamin\n    +boolean status_wali_kelas\n    +timestamp created_at\n    +timestamp updated_at\n    +setWaliKelas()\n    +removeWaliKelas()\n    +getKelasWali()\n}\n\nclass Siswa {\n    +bigint id\n    +string nisn\n    +string nama\n    +enum jenis_kelamin\n    +year tahun_masuk\n    +text alamat\n    +enum status\n    +timestamp created_at\n    +timestamp updated_at\n    +nonaktifkan()\n    +aktifkan()\n    +getRiwayat()\n}\n\nclass Kelas {\n    +bigint id\n    +string tingkat\n    +string jurusan\n    +string nama_kelas\n    +timestamp created_at\n    +timestamp updated_at\n    +getSiswa()\n    +getRiwayat()\n    +hapusJikaAman()\n}\n\nclass TahunAjaran {\n    +bigint id\n    +string tahun_ajaran\n    +date periode_mulai\n    +date periode_selesai\n    +enum status\n    +timestamp created_at\n    +timestamp updated_at\n    +setAktif()\n    +nonaktifkan()\n    +hapusJikaAman()\n}\n\nclass KelasSiswa {\n    +bigint id\n    +bigint siswa_id\n    +bigint kelas_id\n    +bigint tahun_ajaran_id\n    +date mulai\n    +date selesai\n    +text keterangan\n    +timestamp created_at\n    +timestamp updated_at\n    +aktif()\n    +pindahKelas()\n    +riwayat()\n}\n\nclass KategoriPelanggaran {\n    +bigint id\n    +string nama\n    +enum status\n    +timestamp created_at\n    +timestamp updated_at\n    +getJenis()\n    +nonaktifkan()\n}\n\nclass JenisPelanggaran {\n    +bigint id\n    +bigint kategori_id\n    +string nama\n    +int poin_min\n    +int poin_max\n    +enum status\n    +timestamp created_at\n    +timestamp updated_at\n    +getKategori()\n    +nonaktifkan()\n}\n\nclass PelanggaranSiswa {\n    +bigint id\n    +bigint siswa_id\n    +bigint jenis_pelanggaran_id\n    +date tanggal\n    +text keterangan\n    +int poin\n    +int poin_saat_dicatat\n    +enum status\n    +timestamp created_at\n    +timestamp updated_at\n    +batalkan()\n    +getDetail()\n}\n\nclass DetailPelanggaran {\n    +bigint id\n    +bigint pelanggaran_id\n    +enum status\n    +text catatan\n    +timestamp created_at\n    +timestamp updated_at\n    +batal()\n    +editCatatan()\n    +getSnapshotPoin()\n}\n\nclass LogAktivitas {\n    +bigint id\n    +bigint user_id\n    +string aksi\n    +text deskripsi\n    +string ip_address\n    +timestamp created_at\n    +catatAktivitas()\n}\n\n%% INHERITANCE\nGuru --|&gt; User : inheritance\n\n%% RELASI PENEMPATAN KELAS\nSiswa \&quot;1\&quot; --&gt; \&quot;N\&quot; KelasSiswa : memiliki riwayat\nKelas \&quot;1\&quot; --&gt; \&quot;N\&quot; KelasSiswa : memiliki penempatan\nTahunAjaran \&quot;1\&quot; --&gt; \&quot;N\&quot; KelasSiswa : digunakan dalam\n\n%% RELASI PELANGGARAN\nGuru \&quot;1\&quot; --&gt; \&quot;N\&quot; PelanggaranSiswa : menggunakan\nSiswa \&quot;1\&quot; --&gt; \&quot;N\&quot; PelanggaranSiswa : memiliki riwayat\nKategoriPelanggaran \&quot;1\&quot; &lt;-- \&quot;N\&quot; JenisPelanggaran : mencakup\nPelanggaranSiswa \&quot;N\&quot; --&gt; \&quot;1\&quot; DetailPelanggaran : memiliki detail\n\n%% RELASI LOG AKTIVITAS\nPelanggaranSiswa ..&gt; LogAktivitas : mencatat aktivitas\nDetailPelanggaran ..&gt; LogAktivitas : mencatat aktivitas\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="HkLfIW2Ke2iXE5sAcfmO-326">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
