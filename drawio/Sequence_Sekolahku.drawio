        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor Admin\n    participant H as Halaman Detail\n    participant C as Controller\n    database DB as Database\n    participant L as Log Aktivitas\n\n    Admin-&gt;&gt;H: Pilih Hapus\n    H--&gt;&gt;Admin: Tampilkan konfirmasi\n    Admin-&gt;&gt;H: Konfirmasi penghapusan\n    H-&gt;&gt;C: Kirim permintaan hapus\n    C-&gt;&gt;DB: Periksa relasi &amp; riwayat\n    DB--&gt;&gt;C: Status penggunaan data\n    alt Data aman\n        C-&gt;&gt;DB: Hapus permanen\n        DB--&gt;&gt;C: Data berhasil dihapus\n        C-&gt;&gt;L: Catat aktivitas penghapusan\n        L--&gt;&gt;C: Aktivitas tersimpan\n        C--&gt;&gt;H: Penghapusan berhasil\n        H--&gt;&gt;Admin: Tampilkan notifikasi berhasil\n    else Data masih digunakan\n        C--&gt;&gt;H: Tolak penghapusan\n        H--&gt;&gt;Admin: Tampilkan alasan data masih digunakan\n    end&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="HkLfIW2Ke2iXE5sAcfmO-231">
